# Backend Environment Variables
# Copy this file to .env and fill in your values

# Database (Render provides this automatically)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5489;Database=GiftDeliveryDb;Username=postgres;Password=postgres

# JWT
JwtSettings__Secret=SuperSecretKeyThatNeedsToBeLongEnoughForHS256Algorithm_12345!
JwtSettings__Issuer=GiftDeliveryApi
JwtSettings__Audience=GiftDeliveryClients
JwtSettings__ExpirationInMinutes=60

# Stripe (get from https://dashboard.stripe.com)
Stripe__SecretKey=sk_test_your_key
Stripe__PublishableKey=pk_test_your_key

# Email (Gmail App Password)
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=your_email@gmail.com
EmailSettings__SmtpPass=your_app_password
EmailSettings__FromEmail=your_email@gmail.com
EmailSettings__FromName=Mon Gift Delivery

# Twilio (get from https://console.twilio.com)
TwilioSettings__AccountSid=AC_your_sid
TwilioSettings__AuthToken=your_auth_token
TwilioSettings__FromNumber=+1_your_number

# Admin Seed
AdminSetup__Email=superadmin@giftdelivery.com
AdminSetup__Password=SuperSecurePassword123!
AdminSetup__FirstName=Super
AdminSetup__LastName=Admin
